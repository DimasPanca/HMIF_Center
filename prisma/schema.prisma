generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model migrasi {
  nama       String   @id
  checksum   String
  applied_at DateTime @default(now()) @db.Timestamptz(6)
  durasi_ms  Int?

  @@map("_migrasi")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_item {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  notulensi_id   String       @db.Uuid
  tugas          String
  pic_id         String?      @db.Uuid
  deadline       DateTime?    @db.Date
  kanban_card_id String?      @db.Uuid
  kanban_card    kanban_card? @relation(fields: [kanban_card_id], references: [id], onUpdate: NoAction)
  notulensi      notulensi    @relation(fields: [notulensi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user       app_user?    @relation(fields: [pic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([notulensi_id], map: "action_item_notulensi")
}

