# ============================================================
#  HMIF Center — contoh environment variable
#  Salin menjadi .env.local lalu isi nilainya.
#
#    cp .env.example .env.local
#
#  .env.local TIDAK PERNAH masuk version control (.gitignore).
#  Cara mendapatkan tiap nilai: docs/ai/ENV_SETUP.md
#  Sumber: SYSTEM_DESIGN.md §20.1 · ADR-010 · ADR-014
# ============================================================


# ---------- DATABASE ----------
# Connection pooler, dipakai runtime aplikasi (port 6543, transaction mode).
DATABASE_URL=

# Koneksi langsung/session, dipakai migrasi & introspeksi Prisma (port 5432).
# WAJIB berbeda dari DATABASE_URL: migrasi tidak boleh lewat transaction pooler.
DIRECT_URL=


# ---------- SUPABASE ----------
# URL project, terlihat di Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (boleh terekspos ke browser).
# Project baru memakai format `sb_publishable_...` yang menggantikan anon key JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA — server-only. Melewati seluruh policy RLS.
# Project baru memakai format `sb_secret_...` yang menggantikan service_role JWT.
# DILARANG diimpor di file ber-"use client" (AGENT_RULES K-08).
SUPABASE_SECRET_KEY=


# ---------- STORAGE ----------
# supabase | gdrive | local | s3   (lihat SYSTEM_DESIGN §12.1)
STORAGE_DRIVER=supabase

# Bucket privat: master/preview/thumb nota, TTD, dokumen, template, backup.
# Seluruh turunan nota berada di sini — lihat ADR-011.
STORAGE_BUCKET_PRIVATE=private

# Bucket publik: hanya aset yang memang boleh dilihat siapa saja
# (logo, stempel, avatar). Bukan untuk nota.
STORAGE_BUCKET_PUBLIC=public


# ---------- GOOGLE DRIVE (fase berikutnya) ----------
# Biarkan false sampai Service Account HMIF tersedia.
GDRIVE_ENABLED=false
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_BACKUP_FOLDER_ID=


# ---------- KONVERSI PDF (ADR-010) ----------
# false = sistem rilis DOCX-only, opsi PDF disembunyikan di UI dan ditolak server.
# Ubah ke true HANYA setelah Gotenberg/LibreOffice lolos verifikasi
# bahwa teks pada PDF hasil dapat diseleksi (bukan rasterisasi).
PDF_ENABLED=false

# Layanan Gotenberg (Railway/Fly.io). Kosong bila PDF_ENABLED=false.
GOTENBERG_URL=

# Path binary LibreOffice, hanya dipakai saat deploy di VPS.
SOFFICE_PATH=


# ---------- APLIKASI ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RAHASIA — memverifikasi request dari Vercel Cron (ADR-009).
# Bangkitkan acak, mis. dengan: openssl rand -base64 32
CRON_SECRET=

# Versi skema untuk validasi manifest backup/restore.
SCHEMA_VERSION=1


# ---------- BATAS UPLOAD (ADR-014) ----------
# 15 MB. Hanya JPEG, PNG, dan WebP, divalidasi lewat magic bytes.
MAX_UPLOAD_BYTES=15728640
