{
  "name": "hmif-center",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem E-Administrasi Himpunan Mahasiswa Informatika FT UNTIRTA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:env": "tsx scripts/check-env.ts",
    "check:lazy-env": "tsx scripts/check-lazy-env.ts",
    "check:secrets": "tsx scripts/check-client-secrets.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:pull": "prisma db pull && prisma generate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:status": "tsx scripts/db.ts status",
    "db:test": "tsx scripts/db-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lane": "tsx scripts/lane.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "rls:coverage": "tsx scripts/rls-coverage.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:e2e-auth": "tsx scripts/seed-e2e-auth.ts",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm run check:lazy-env && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/pm": "^3.6.2",
    "@tiptap/react": "^3.6.2",
    "@tiptap/starter-kit": "^3.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.66.6",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "file-type": "^21.0.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.25",
    "pizzip": "^3.2.0",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.63.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^6.16.2",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
