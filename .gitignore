# ============================================================
#  HMIF Center — .gitignore
#  Aturan: rahasia, artefak build, dan dump data TIDAK PERNAH
#  masuk version control. Lihat AGENT_RULES.md §4 Larangan Keras.
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# --- Next.js / build ---
.next/
out/
build/
dist/
next-env.d.ts
.turbo/
tsconfig.tsbuildinfo
.eslintcache

# --- Environment: RAHASIA, jangan pernah di-commit ---
.env
.env.*
!.env.example

# --- Vercel ---
.vercel/

# --- Testing ---
coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/

# --- Log ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database dump, backup, file sementara ---
*.sql.gz
/backups/
/tmp/
prisma/*.db
prisma/*.db-journal
supabase/.temp/

# --- Artefak yang dihasilkan skrip (bukan sumber) ---
docs/ai/rab-template-dump.txt

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~
